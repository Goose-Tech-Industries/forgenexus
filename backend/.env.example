# ===========================================
# ForgeNexus — Production Environment Config
# ===========================================
# Copy this file to .env and fill in your values.
# Generate SECRET_KEY_BASE with: mix phx.gen.secret

# --- Required ---
PHX_SERVER=true
PHX_HOST=yourdomain.com
PORT=4000
SECRET_KEY_BASE=GENERATE_WITH_mix_phx.gen.secret
DATABASE_URL=ecto://forge_nexus:YOUR_PASSWORD@localhost/forge_nexus_prod

# --- Email (Resend) ---
RESEND_API_KEY=re_your_resend_api_key_here

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com

# --- Database ---
DATABASE_SSL=false
POOL_SIZE=40
# ECTO_IPV6=true

# --- Search (Meilisearch) ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=your_meilisearch_master_key

# --- Read Replica (optional — for heavy read workloads) ---
# READ_REPLICA_URL=ecto://forge_nexus:YOUR_PASSWORD@postgres-replica:5432/forge_nexus_prod
# REPLICA_POOL_SIZE=10

# --- Optional ---
# GUARDIAN_SECRET_KEY=   # Defaults to SECRET_KEY_BASE if not set
# DNS_CLUSTER_QUERY=     # For multi-node clustering
